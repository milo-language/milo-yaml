// yaml — a YAML 1.2 subset parser for Milo.
//
// A document parses into a flat node pool. Every handle is a `NodeId` (a newtype
// over the pool index) and a nil handle means "missing", so lookups chain without
// an Option at each step: `doc.getInt(doc.path("server.port")) ?? 8080`.
//
// The pool shape (rather than a recursive enum) is deliberate: Milo has no
// pointers in safe code, so a self-referential value type would need an arena
// anyway — and indices make the whole document one contiguous, cheaply-cloned
// value.

from "std/strconv" import { parseInt, parseIntRadix, parseFloat }

// Node kinds. The integer repr is the pool's storage; the variant names are the public
// spelling — one type instead of a parallel `K_*` i32 table. Scalar kinds sort below Str,
// which `isScalar` relies on via `kind as i32`.
pub enum YamlKind: i32 {
    Null,       // 0
    Bool,       // 1
    Int,        // 2
    Float,      // 3
    Str,        // 4
    Seq,        // 5
    Map,        // 6
    Missing,    // 7 — only the accessor returns it, for an invalid node
}

// Two distinct pool-index spaces run through this file, both formerly bare `i64`.
// Making each a single-field struct gives a zero-cost, *distinct* Copy type: the
// checker now rejects indexing the string pool with a node handle (or vice
// versa), the one class of mix-up bare indices could never catch.
//   NodeId — index into the node pool (`Yaml.nodes` / `YamlParser.nodes`)
//   StrId  — index into the string pool (`Yaml.strs` / `YamlParser.strs`)
pub struct NodeId {
    idx: i64,
}

pub struct StrId {
    idx: i64,
}

// `-1` stays the "missing" sentinel it was as an i64, so chained lookups still
// bottom out without an Option at each hop.
fn nilNode(): NodeId { return NodeId { idx: -1 } }
fn isNilNode(h: NodeId): bool { return h.idx < 0 }
fn nilStr(): StrId { return StrId { idx: -1 } }
fn isNilStr(h: StrId): bool { return h.idx < 0 }

pub struct YamlNode {
    kind: YamlKind,
    boolVal: bool,
    intVal: i64,
    floatVal: f64,
    // String-pool handle, or nil. Set for string scalars and for the raw text
    // of every scalar, so `scalarText` works on a number without reformatting it.
    strIdx: StrId,
    // String-pool handle for this node's key, when it is a map entry's value.
    keyIdx: StrId,
    // Offset + span into the owning document's `childIdx` (a child-array offset,
    // not a node handle), so these stay plain i64.
    childStart: i64,
    childCount: i64,
}

pub struct Yaml {
    nodes: Vec<YamlNode>,
    childIdx: Vec<NodeId>,
    strs: Vec<string>,
    root: NodeId,
}

// ── Lexical helpers ──────────────────────────────────────────────────────────

fn indentOf(line: &string): i64 {
    var i: i64 = 0
    while i < line.len && line[i] == ' ' {
        i = i + 1
    }
    return i
}

fn isBlankLine(line: &string): bool {
    let i = indentOf(line)
    if i >= line.len {
        return true
    }
    return line[i] == '#'
}

fn isSeqEntry(text: &string): bool {
    if text.len == 0 || text[0] != '-' {
        return false
    }
    return text.len == 1 || text[1] == ' '
}

// Position of the ':' that terminates a block mapping key, or -1. YAML requires
// the colon be followed by a space or end-of-line, which is what keeps
// `http://host` from reading as a key.
fn findKeyColon(text: &string): i64 {
    var depth: i64 = 0
    var i: i64 = 0
    while i < text.len {
        let c = text[i]
        if c == '\'' || c == '"' {
            let end = skipQuoted(text, i)
            if end < 0 {
                return -1
            }
            i = end
            continue
        }
        if c == '[' || c == '{' {
            depth = depth + 1
        } else if c == ']' || c == '}' {
            depth = depth - 1
        } else if c == ':' && depth == 0 {
            if i + 1 >= text.len || text[i + 1] == ' ' {
                return i
            }
        } else if c == '#' && i > 0 && text[i - 1] == ' ' && depth == 0 {
            return -1
        }
        i = i + 1
    }
    return -1
}

// Index just past a quoted run starting at `start`, or -1 if it never closes.
fn skipQuoted(text: &string, start: i64): i64 {
    let q = text[start]
    var i = start + 1
    while i < text.len {
        if text[i] == q {
            // '' inside a single-quoted scalar is an escaped quote.
            if q == '\'' && i + 1 < text.len && text[i + 1] == '\'' {
                i = i + 2
                continue
            }
            return i + 1
        }
        if q == '"' && text[i] == '\\' {
            i = i + 2
            continue
        }
        i = i + 1
    }
    return -1
}

// Drop a trailing ` # comment` from a plain scalar. A '#' that is not preceded
// by a space is part of the scalar (`#tag`), and one inside quotes is data.
fn stripComment(text: &string): string {
    var i: i64 = 0
    while i < text.len {
        let c = text[i]
        if c == '\'' || c == '"' {
            let end = skipQuoted(text, i)
            if end < 0 {
                break
            }
            i = end
            continue
        }
        if c == '#' && i > 0 && text[i - 1] == ' ' {
            return text.substr(0, i).trim()
        }
        i = i + 1
    }
    return text.trim()
}

fn isDigitByte(c: u8): bool {
    return c >= '0' && c <= '9'
}

// ── Scalar typing (YAML 1.2 core schema) ─────────────────────────────────────

fn looksNull(s: &string): bool {
    return s.len == 0 || s == "~" || s == "null" || s == "Null" || s == "NULL"
}

fn looksTrue(s: &string): bool {
    return s == "true" || s == "True" || s == "TRUE"
}

fn looksFalse(s: &string): bool {
    return s == "false" || s == "False" || s == "FALSE"
}

// Digits with optional `_` separators, after any sign/radix prefix.
fn digitsOnly(s: &string, from: i64, radix: i32): bool {
    var seen = false
    var i = from
    while i < s.len {
        let c = s[i]
        if c == '_' {
            i = i + 1
            continue
        }
        var ok = false
        if radix == 10 {
            ok = isDigitByte(c)
        } else if radix == 16 {
            ok = isDigitByte(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
        } else if radix == 8 {
            ok = c >= '0' && c <= '7'
        } else {
            ok = c == '0' || c == '1'
        }
        if !ok {
            return false
        }
        seen = true
        i = i + 1
    }
    return seen
}

fn stripUnderscores(s: &string): string {
    var out = ""
    for c in s {
        if c != '_' {
            out.push(c)
        }
    }
    return out
}

fn parseYamlInt(s: &string): Option<i64> {
    if s.len == 0 {
        return Option.None
    }
    var body = s.clone()
    var neg = false
    if body[0] == '+' || body[0] == '-' {
        neg = body[0] == '-'
        body = body.substr(1, body.len)
    }
    if body.len == 0 {
        return Option.None
    }
    if body.len > 2 && body[0] == '0' && (body[1] == 'x' || body[1] == 'X') {
        if !digitsOnly(body, 2, 16) {
            return Option.None
        }
        let digits = stripUnderscores(body.substr(2, body.len))
        let v = parseIntRadix(digits, 16)?
        return Option.Some(if neg { -v } else { v })
    }
    if body.len > 2 && body[0] == '0' && (body[1] == 'o' || body[1] == 'O') {
        if !digitsOnly(body, 2, 8) {
            return Option.None
        }
        let digits = stripUnderscores(body.substr(2, body.len))
        let v = parseIntRadix(digits, 8)?
        return Option.Some(if neg { -v } else { v })
    }
    if body.len > 2 && body[0] == '0' && (body[1] == 'b' || body[1] == 'B') {
        if !digitsOnly(body, 2, 2) {
            return Option.None
        }
        let digits = stripUnderscores(body.substr(2, body.len))
        let v = parseIntRadix(digits, 2)?
        return Option.Some(if neg { -v } else { v })
    }
    if !digitsOnly(body, 0, 10) {
        return Option.None
    }
    let v = parseInt(stripUnderscores(body))?
    return Option.Some(if neg { -v } else { v })
}

fn parseYamlFloat(s: &string): Option<f64> {
    if s == ".inf" || s == ".Inf" || s == ".INF" || s == "+.inf" {
        return Option.Some(f64.INF)
    }
    if s == "-.inf" || s == "-.Inf" || s == "-.INF" {
        return Option.Some(f64.NEG_INF)
    }
    if s == ".nan" || s == ".NaN" || s == ".NAN" {
        return Option.Some(f64.NAN)
    }
    // Reject anything the float grammar doesn't allow before handing it to
    // parseFloat, which is lenient about trailing junk.
    var i: i64 = 0
    if i < s.len && (s[i] == '+' || s[i] == '-') {
        i = i + 1
    }
    var digits = false
    var dot = false
    var expo = false
    var j = i
    while j < s.len {
        let c = s[j]
        if isDigitByte(c) {
            digits = true
        } else if c == '.' && !dot && !expo {
            dot = true
        } else if (c == 'e' || c == 'E') && digits && !expo {
            expo = true
            if j + 1 < s.len && (s[j + 1] == '+' || s[j + 1] == '-') {
                j = j + 1
            }
        } else if c != '_' {
            return Option.None
        }
        j = j + 1
    }
    if !digits || (!dot && !expo) {
        return Option.None
    }
    return parseFloat(stripUnderscores(s))
}

// ── Parser ───────────────────────────────────────────────────────────────────

struct YamlParser {
    lines: Vec<string>,
    pos: i64,
    nodes: Vec<YamlNode>,
    childIdx: Vec<NodeId>,
    strs: Vec<string>,
    // Anchor name → node. insert overwrites, so a redefined anchor resolves to the most
    // recent binding (same as the old last-wins reverse scan), now O(1).
    anchors: HashMap<string, NodeId>,
    // Set by the line-level parser when a `&name` marker precedes a value whose
    // node is only built later (a nested block). Consumed by whoever finishes it.
    pendingAnchor: string,
}

fn yamlSplitLines(src: &string): Vec<string> {
    var out: Vec<string> = Vec.new()
    var cur = ""
    for c in src {
        if c == '\n' {
            out.push(cur)
            cur = ""
        } else if c != '\r' {
            cur.push(c)
        }
    }
    out.push(cur)
    return out
}

fn newParser(src: &string): YamlParser {
    return YamlParser {
        lines: yamlSplitLines(src),
        pos: 0,
        nodes: Vec.new(),
        childIdx: Vec.new(),
        strs: Vec.new(),
        anchors: HashMap.new(),
        pendingAnchor: "",
    }
}

impl YamlParser {
    fn addStr(self: &mut Self, s: string): StrId {
        self.strs.push(s)
        return StrId { idx: self.strs.len - 1 }
    }

    fn addNode(self: &mut Self, kind: YamlKind): NodeId {
        self.nodes.push(YamlNode {
            kind: kind, boolVal: false, intVal: 0, floatVal: 0.0,
            strIdx: nilStr(), keyIdx: nilStr(), childStart: 0, childCount: 0,
        })
        return NodeId { idx: self.nodes.len - 1 }
    }

    // A container's children are flattened into `childIdx` only once its whole
    // subtree is parsed, so nested containers interleave safely.
    fn attach(self: &mut Self, node: NodeId, kids: &Vec<NodeId>) {
        let start = self.childIdx.len
        for k in kids {
            self.childIdx.push(k)
        }
        self.nodes[node.idx].childStart = start
        self.nodes[node.idx].childCount = kids.len
    }

    fn atEnd(self: &Self): bool {
        return self.pos >= self.lines.len
    }

    fn skipBlanks(self: &mut Self) {
        while self.pos < self.lines.len && isBlankLine(self.lines[self.pos]) {
            self.pos = self.pos + 1
        }
    }

    fn curIndent(self: &Self): i64 {
        return indentOf(self.lines[self.pos])
    }

    fn curText(self: &Self): string {
        let line = self.lines[self.pos]
        let ind = indentOf(line)
        return line.substr(ind, line.len)
    }

    fn errAt(self: &Self, msg: &string): string {
        return $"line {self.pos + 1}: {msg}"
    }

    // A document boundary ends whatever block is being parsed.
    fn atDocBoundary(self: &Self): bool {
        if self.atEnd() {
            return true
        }
        let t = self.curText()
        return t == "---" || t == "..." || t.startsWith("--- ")
    }

    fn defineAnchor(self: &mut Self, name: string, node: NodeId) {
        if name.len == 0 {
            return
        }
        self.anchors.insert(name, node)
    }

    fn lookupAnchor(self: &Self, name: &string): NodeId {
        if let Option.Some(id) = self.anchors.get(name.clone()) {
            return id
        }
        return nilNode()
    }

    // An alias binds a *new* handle to the same children, because the caller may
    // stamp a map key onto it and that must not touch the anchored node.
    fn cloneNode(self: &mut Self, src: NodeId): NodeId {
        let kind = self.nodes[src.idx].kind
        let id = self.addNode(kind)
        self.nodes[id.idx].boolVal = self.nodes[src.idx].boolVal
        self.nodes[id.idx].intVal = self.nodes[src.idx].intVal
        self.nodes[id.idx].floatVal = self.nodes[src.idx].floatVal
        self.nodes[id.idx].strIdx = self.nodes[src.idx].strIdx
        self.nodes[id.idx].childStart = self.nodes[src.idx].childStart
        self.nodes[id.idx].childCount = self.nodes[src.idx].childCount
        return id
    }

    fn scalarNode(self: &mut Self, text: &string, quoted: bool): NodeId {
        if quoted {
            let id = self.addNode(YamlKind.Str)
            self.nodes[id.idx].strIdx = self.addStr(text.clone())
            return id
        }
        if looksNull(text) {
            let id = self.addNode(YamlKind.Null)
            self.nodes[id.idx].strIdx = self.addStr(text.clone())
            return id
        }
        if looksTrue(text) || looksFalse(text) {
            let id = self.addNode(YamlKind.Bool)
            self.nodes[id.idx].boolVal = looksTrue(text)
            self.nodes[id.idx].strIdx = self.addStr(text.clone())
            return id
        }
        if let Option.Some(n) = parseYamlInt(text) {
            let id = self.addNode(YamlKind.Int)
            self.nodes[id.idx].intVal = n
            self.nodes[id.idx].floatVal = n as f64
            self.nodes[id.idx].strIdx = self.addStr(text.clone())
            return id
        }
        if let Option.Some(f) = parseYamlFloat(text) {
            let id = self.addNode(YamlKind.Float)
            self.nodes[id.idx].floatVal = f
            self.nodes[id.idx].strIdx = self.addStr(text.clone())
            return id
        }
        let id = self.addNode(YamlKind.Str)
        self.nodes[id.idx].strIdx = self.addStr(text.clone())
        return id
    }

    // ── Block level ──────────────────────────────────────────────────────────

    fn parseBlock(self: &mut Self, indent: i64): Result<NodeId> {
        self.skipBlanks()
        if self.atDocBoundary() {
            return Result.Ok(self.addNode(YamlKind.Null))
        }
        let text = self.curText()
        if isSeqEntry(text) {
            return self.parseSeq(indent)
        }
        if findKeyColon(text) >= 0 {
            return self.parseMap(indent)
        }
        return self.parseLineValue(indent)
    }

    // The value that follows `key:` (or `-`) with nothing after it on the line.
    // A block sequence is allowed to sit at the parent's own indentation, which
    // is why this can't just recurse at `indent + 1`.
    fn parseIndentedValue(self: &mut Self, indent: i64): Result<NodeId> {
        self.skipBlanks()
        if self.atDocBoundary() {
            return Result.Ok(self.addNode(YamlKind.Null))
        }
        let childIndent = self.curIndent()
        if childIndent > indent {
            return self.parseBlock(childIndent)
        }
        if childIndent == indent && isSeqEntry(self.curText()) {
            return self.parseSeq(indent)
        }
        return Result.Ok(self.addNode(YamlKind.Null))
    }

    fn parseSeq(self: &mut Self, indent: i64): Result<NodeId> {
        let node = self.addNode(YamlKind.Seq)
        let anchor = replace(self.pendingAnchor, "")
        if anchor.len > 0 {
            self.defineAnchor(anchor, node)
        }
        var kids: Vec<NodeId> = Vec.new()
        while true {
            self.skipBlanks()
            if self.atDocBoundary() {
                break
            }
            if self.curIndent() != indent {
                break
            }
            let text = self.curText()
            if !isSeqEntry(text) {
                break
            }
            let rest = text.substr(1, text.len).trimEnd()
            let restTrimmed = rest.trim()
            if restTrimmed.len == 0 || restTrimmed.startsWith("#") {
                self.pos = self.pos + 1
                let child = self.parseIndentedValue(indent)?
                kids.push(child)
                continue
            }
            // A compact entry (`- name: x`, `- - nested`) is the same grammar one
            // column over: blank out the dash and re-parse the line at that column.
            let lead = rest.len - rest.trimStart().len
            let restCol = indent + 1 + lead
            var rewritten = " ".repeat(restCol)
            rewritten.pushStr(rest.trimStart())
            self.lines[self.pos] = rewritten
            let child = self.parseBlock(restCol)?
            kids.push(child)
        }
        self.attach(node, kids)
        return Result.Ok(node)
    }

    fn parseMap(self: &mut Self, indent: i64): Result<NodeId> {
        let node = self.addNode(YamlKind.Map)
        let anchor = replace(self.pendingAnchor, "")
        if anchor.len > 0 {
            self.defineAnchor(anchor, node)
        }
        var kids: Vec<NodeId> = Vec.new()
        // `<<` merges are appended last so that explicitly-written keys, which
        // `get` finds first, always win over merged ones.
        var merged: Vec<NodeId> = Vec.new()
        while true {
            self.skipBlanks()
            if self.atDocBoundary() {
                break
            }
            if self.curIndent() != indent {
                break
            }
            let text = self.curText()
            if isSeqEntry(text) {
                break
            }
            let colon = findKeyColon(text)
            if colon < 0 {
                return Result.Err(self.errAt("expected 'key: value'"))
            }
            let rawKey = text.substr(0, colon).trim()
            var key = rawKey.clone()
            if rawKey.len >= 2 && (rawKey[0] == '"' || rawKey[0] == '\'') {
                key = unquote(rawKey)?
            }
            var rest = text.substr(colon + 1, text.len).trim()

            // `&anchor` / `!!tag` may sit between the colon and the value.
            var anchorName = ""
            if rest.len > 0 && rest[0] == '&' {
                let cut = tokenEnd(rest, 1)
                anchorName = rest.substr(1, cut)
                rest = rest.substr(cut, rest.len).trim()
            }
            if rest.len > 1 && rest[0] == '!' {
                let cut = tokenEnd(rest, 1)
                rest = rest.substr(cut, rest.len).trim()
            }

            var value: NodeId = nilNode()
            if rest.len == 0 || rest.startsWith("#") {
                self.pendingAnchor = anchorName.clone()
                self.pos = self.pos + 1
                value = self.parseIndentedValue(indent)?
                self.pendingAnchor = ""
            } else {
                // Replace the line with just the value so the line-level parser
                // (block scalars, flow, aliases) sees it in isolation.
                var rewritten = " ".repeat(indent)
                rewritten.pushStr(rest)
                self.lines[self.pos] = rewritten
                value = self.parseLineValue(indent)?
                if anchorName.len > 0 {
                    self.defineAnchor(anchorName, value)
                }
            }

            if key == "<<" {
                self.collectMerge(value, merged)
                continue
            }
            self.nodes[value.idx].keyIdx = self.addStr(key)
            kids.push(value)
        }
        // A merged entry is dropped outright when the map wrote that key itself:
        // keeping it would leave a duplicate key in the document that only the
        // first-match rule in `get` papered over.
        for m in merged {
            let mk = self.nodes[m.idx].keyIdx
            var dup = false
            for k in kids {
                let ek = self.nodes[k.idx].keyIdx
                if !isNilStr(mk) && !isNilStr(ek) && self.strs[mk.idx] == self.strs[ek.idx] {
                    dup = true
                }
            }
            if !dup {
                kids.push(m)
            }
        }
        self.attach(node, kids)
        return Result.Ok(node)
    }

    // `<<: *base` (or a sequence of them) splices the referenced map's entries in.
    fn collectMerge(self: &mut Self, value: NodeId, out: &mut Vec<NodeId>) {
        let kind = self.nodes[value.idx].kind
        if kind == YamlKind.Map {
            let start = self.nodes[value.idx].childStart
            let count = self.nodes[value.idx].childCount
            for i in 0..count {
                out.push(self.childIdx[start + i])
            }
        } else if kind == YamlKind.Seq {
            let start = self.nodes[value.idx].childStart
            let count = self.nodes[value.idx].childCount
            for i in 0..count {
                let child = self.childIdx[start + i]
                self.collectMerge(child, out)
            }
        }
    }

    // ── Line level: block scalars, flow collections, aliases, plain scalars ──

    fn parseLineValue(self: &mut Self, indent: i64): Result<NodeId> {
        let text = self.curText()
        if text.len > 0 && (text[0] == '|' || text[0] == '>') {
            return self.parseBlockScalar(text, indent)
        }
        if text.len > 1 && text[0] == '*' {
            let cut = tokenEnd(text, 1)
            let name = text.substr(1, cut)
            let target = self.lookupAnchor(name)
            if isNilNode(target) {
                return Result.Err(self.errAt($"unknown alias '*{name}'"))
            }
            self.pos = self.pos + 1
            return Result.Ok(self.cloneNode(target))
        }
        var body = text.clone()
        var anchorName = replace(self.pendingAnchor, "")
        if body.len > 1 && body[0] == '&' {
            let cut = tokenEnd(body, 1)
            anchorName = body.substr(1, cut)
            body = body.substr(cut, body.len).trim()
        }
        if body.len > 1 && body[0] == '!' {
            let cut = tokenEnd(body, 1)
            body = body.substr(cut, body.len).trim()
        }
        if body.len > 0 && (body[0] == '[' || body[0] == '{') {
            let res = self.parseFlow(body, 0)?
            self.pos = self.pos + 1
            if anchorName.len > 0 {
                self.defineAnchor(anchorName, res.node)
            }
            return Result.Ok(res.node)
        }
        self.pos = self.pos + 1
        var node: NodeId = nilNode()
        if body.len >= 2 && (body[0] == '"' || body[0] == '\'') && skipQuoted(body, 0) == body.len {
            node = self.scalarNode(unquote(body)?, true)
        } else {
            node = self.scalarNode(stripComment(body), false)
        }
        if anchorName.len > 0 {
            self.defineAnchor(anchorName, node)
        }
        return Result.Ok(node)
    }

    // `|`, `>`, with chomping (`-`/`+`) and an optional explicit indent digit.
    fn parseBlockScalar(self: &mut Self, header: &string, parentIndent: i64): Result<NodeId> {
        let folded = header[0] == '>'
        var chomp = 0     // 0 clip, 1 strip, 2 keep
        var explicitIndent: i64 = 0
        var i: i64 = 1
        while i < header.len {
            let c = header[i]
            if c == '-' {
                chomp = 1
            } else if c == '+' {
                chomp = 2
            } else if isDigitByte(c) {
                explicitIndent = (c - '0') as i64
            } else {
                break
            }
            i = i + 1
        }
        self.pos = self.pos + 1

        var raw: Vec<string> = Vec.new()
        var contentIndent: i64 = -1
        if explicitIndent > 0 {
            contentIndent = parentIndent + explicitIndent
        }
        while self.pos < self.lines.len {
            let line = self.lines[self.pos]
            let blank = line.trim().len == 0
            if !blank {
                let ind = indentOf(line)
                if ind <= parentIndent {
                    break
                }
                if contentIndent < 0 {
                    contentIndent = ind
                }
                if ind < contentIndent {
                    break
                }
                raw.push(line.substr(contentIndent, line.len).trimEnd())
            } else {
                raw.push("")
            }
            self.pos = self.pos + 1
        }
        // Trailing blank lines belong to chomping, not to the body.
        var trailing: i64 = 0
        while raw.len > 0 && raw[raw.len - 1].len == 0 {
            let _ = raw.pop()
            trailing = trailing + 1
        }

        var body = ""
        if folded {
            var started = false
            var blanks: i64 = 0
            var prevLiteral = false
            for ln in 0..raw.len {
                let line = raw[ln]
                if line.len == 0 {
                    if started {
                        blanks = blanks + 1
                    }
                    continue
                }
                let literal = line[0] == ' '
                if !started {
                    body.pushStr(line)
                    started = true
                } else {
                    if blanks > 0 {
                        for k in 0..blanks {
                            body.push('\n')
                        }
                    } else if literal || prevLiteral {
                        body.push('\n')
                    } else {
                        body.push(' ')
                    }
                    body.pushStr(line)
                }
                blanks = 0
                prevLiteral = literal
            }
        } else {
            for ln in 0..raw.len {
                if ln > 0 {
                    body.push('\n')
                }
                body.pushStr(raw[ln])
            }
        }
        if chomp == 0 {
            if body.len > 0 {
                body.push('\n')
            }
        } else if chomp == 2 {
            body.push('\n')
            for k in 0..trailing {
                body.push('\n')
            }
        }
        let anchor = replace(self.pendingAnchor, "")
        let id = self.scalarNode(body, true)
        if anchor.len > 0 {
            self.defineAnchor(anchor, id)
        }
        return Result.Ok(id)
    }

    // Flow collections are single-line in this subset; `next` is the offset just
    // past the value that was parsed.
    fn parseFlow(self: &mut Self, text: &string, from: i64): Result<FlowRes> {
        // FlowRes.node carries a NodeId; the `next` offset stays a plain i64.
        var i = skipSpaces(text, from)
        if i >= text.len {
            return Result.Err(self.errAt("unexpected end of flow collection"))
        }
        let c = text[i]
        if c == '[' {
            let node = self.addNode(YamlKind.Seq)
            var kids: Vec<NodeId> = Vec.new()
            i = skipSpaces(text, i + 1)
            while i < text.len && text[i] != ']' {
                let res = self.parseFlow(text, i)?
                kids.push(res.node)
                i = skipSpaces(text, res.next)
                if i < text.len && text[i] == ',' {
                    i = skipSpaces(text, i + 1)
                }
            }
            if i >= text.len {
                return Result.Err(self.errAt("unterminated '['"))
            }
            self.attach(node, kids)
            return Result.Ok(FlowRes { node: node, next: i + 1 })
        }
        if c == '{' {
            let node = self.addNode(YamlKind.Map)
            var kids: Vec<NodeId> = Vec.new()
            i = skipSpaces(text, i + 1)
            while i < text.len && text[i] != '}' {
                let keyEnd = flowScalarEnd(text, i, ":,}")
                let rawKey = text.substr(i, keyEnd).trim()
                var key = rawKey.clone()
                if rawKey.len >= 2 && (rawKey[0] == '"' || rawKey[0] == '\'') {
                    key = unquote(rawKey)?
                }
                i = skipSpaces(text, keyEnd)
                var value: NodeId = nilNode()
                if i < text.len && text[i] == ':' {
                    let res = self.parseFlow(text, i + 1)?
                    value = res.node
                    i = skipSpaces(text, res.next)
                } else {
                    value = self.addNode(YamlKind.Null)
                }
                self.nodes[value.idx].keyIdx = self.addStr(key)
                kids.push(value)
                if i < text.len && text[i] == ',' {
                    i = skipSpaces(text, i + 1)
                }
            }
            if i >= text.len {
                return Result.Err(self.errAt("unterminated '{'"))
            }
            self.attach(node, kids)
            return Result.Ok(FlowRes { node: node, next: i + 1 })
        }
        if c == '"' || c == '\'' {
            let end = skipQuoted(text, i)
            if end < 0 {
                return Result.Err(self.errAt("unterminated quoted scalar"))
            }
            let node = self.scalarNode(unquote(text.substr(i, end))?, true)
            return Result.Ok(FlowRes { node: node, next: end })
        }
        if c == '*' {
            let end = flowScalarEnd(text, i, ",]}")
            let name = text.substr(i + 1, end).trim()
            let target = self.lookupAnchor(name)
            if isNilNode(target) {
                return Result.Err(self.errAt($"unknown alias '*{name}'"))
            }
            return Result.Ok(FlowRes { node: self.cloneNode(target), next: end })
        }
        let end = flowScalarEnd(text, i, ",]}")
        let body = text.substr(i, end).trim()
        return Result.Ok(FlowRes { node: self.scalarNode(body, false), next: end })
    }
}

struct FlowRes {
    node: NodeId,
    next: i64,
}

fn skipSpaces(text: &string, from: i64): i64 {
    var i = from
    while i < text.len && (text[i] == ' ' || text[i] == '\t') {
        i = i + 1
    }
    return i
}

// End of a plain flow scalar: the first unnested delimiter from `stops`.
fn flowScalarEnd(text: &string, from: i64, stops: &string): i64 {
    var depth: i64 = 0
    var i = from
    while i < text.len {
        let c = text[i]
        if c == '\'' || c == '"' {
            let end = skipQuoted(text, i)
            if end < 0 {
                return text.len
            }
            i = end
            continue
        }
        if c == '[' || c == '{' {
            depth = depth + 1
        } else if c == ']' || c == '}' {
            if depth == 0 && stops.contains("]") {
                return i
            }
            depth = depth - 1
        } else if depth == 0 {
            var hit = false
            for s in stops {
                if s == c {
                    hit = true
                }
            }
            if hit {
                // ':' only ends a flow key when followed by a space or delimiter.
                if c != ':' || i + 1 >= text.len || text[i + 1] == ' ' || text[i + 1] == ',' {
                    return i
                }
            }
        }
        i = i + 1
    }
    return text.len
}

fn tokenEnd(text: &string, from: i64): i64 {
    var i = from
    while i < text.len && text[i] != ' ' {
        i = i + 1
    }
    return i
}

fn hexVal(c: u8): i64 {
    if c >= '0' && c <= '9' {
        return (c - '0') as i64
    }
    if c >= 'a' && c <= 'f' {
        return (c - 'a') as i64 + 10
    }
    if c >= 'A' && c <= 'F' {
        return (c - 'A') as i64 + 10
    }
    return -1
}

fn encodeUtf8(out: &mut string, cp: i64) {
    if cp < 128 {
        out.push(cp as u8)
    } else if cp < 2048 {
        out.push((192 + (cp / 64)) as u8)
        out.push((128 + (cp % 64)) as u8)
    } else if cp < 65536 {
        out.push((224 + (cp / 4096)) as u8)
        out.push((128 + ((cp / 64) % 64)) as u8)
        out.push((128 + (cp % 64)) as u8)
    } else {
        out.push((240 + (cp / 262144)) as u8)
        out.push((128 + ((cp / 4096) % 64)) as u8)
        out.push((128 + ((cp / 64) % 64)) as u8)
        out.push((128 + (cp % 64)) as u8)
    }
}

// Strip the quotes from a quoted scalar and apply the escape rules for its style.
pub fn unquote(text: &string): Result<string> {
    if text.len < 2 {
        return Result.Err($"malformed quoted scalar: {text}")
    }
    let q = text[0]
    var out = ""
    var i: i64 = 1
    let last = text.len - 1
    if q == '\'' {
        while i < last {
            if text[i] == '\'' && i + 1 < last && text[i + 1] == '\'' {
                out.push('\'')
                i = i + 2
                continue
            }
            out.push(text[i])
            i = i + 1
        }
        return Result.Ok(out)
    }
    while i < last {
        let c = text[i]
        if c != '\\' {
            out.push(c)
            i = i + 1
            continue
        }
        i = i + 1
        if i >= last {
            return Result.Err("dangling '\\' in double-quoted scalar")
        }
        let e = text[i]
        if e == 'n' {
            out.push('\n')
        } else if e == 't' {
            out.push('\t')
        } else if e == 'r' {
            out.push('\r')
        } else if e == '0' {
            out.push(0 as u8)
        } else if e == 'a' {
            out.push(7 as u8)
        } else if e == 'b' {
            out.push(8 as u8)
        } else if e == 'f' {
            out.push(12 as u8)
        } else if e == 'v' {
            out.push(11 as u8)
        } else if e == 'e' {
            out.push(27 as u8)
        } else if e == '"' || e == '\\' || e == '/' || e == '\'' {
            out.push(e)
        } else if e == 'x' || e == 'u' || e == 'U' {
            var width: i64 = 2
            if e == 'u' {
                width = 4
            }
            if e == 'U' {
                width = 8
            }
            if i + width >= text.len {
                return Result.Err("truncated escape in double-quoted scalar")
            }
            var cp: i64 = 0
            for k in 0..width {
                let h = hexVal(text[i + 1 + k])
                if h < 0 {
                    return Result.Err("bad hex escape in double-quoted scalar")
                }
                cp = cp * 16 + h
            }
            i = i + width
            encodeUtf8(out, cp)
        } else {
            out.push(e)
        }
        i = i + 1
    }
    return Result.Ok(out)
}

// ── Entry points ─────────────────────────────────────────────────────────────

fn finish(p: YamlParser, root: NodeId): Yaml {
    return Yaml { nodes: p.nodes, childIdx: p.childIdx, strs: p.strs, root: root }
}

// Parse the first document in `src`.
pub fn yamlParse(src: string): Result<Yaml> {
    var p = newParser(src)
    p.skipBlanks()
    if !p.atEnd() {
        let t = p.curText()
        if t == "---" || t.startsWith("--- ") {
            p.pos = p.pos + 1
        }
    }
    let root = p.parseBlock(0)?
    return Result.Ok(finish(p, root))
}

// Parse every `---`-separated document in `src`. An empty input yields one
// null document, which is what YAML says an empty stream means.
pub fn yamlParseAll(src: string): Result<Vec<Yaml>> {
    var out: Vec<Yaml> = Vec.new()
    var p = newParser(src)
    while true {
        p.skipBlanks()
        if p.atEnd() {
            break
        }
        let t = p.curText()
        if t == "..." {
            p.pos = p.pos + 1
            continue
        }
        if t == "---" || t.startsWith("--- ") {
            p.pos = p.pos + 1
            p.skipBlanks()
            if p.atEnd() {
                break
            }
        }
        let root = p.parseBlock(0)?
        // Each document gets its own copy of the pool: handles are only
        // meaningful relative to the document they came from.
        out.push(Yaml {
            nodes: cloneNodes(p.nodes), childIdx: cloneIdx(p.childIdx), strs: cloneStrs(p.strs), root: root,
        })
    }
    if out.len == 0 {
        var empty = newParser("")
        let n = empty.addNode(YamlKind.Null)
        out.push(finish(empty, n))
    }
    return Result.Ok(out)
}

fn cloneNodes(src: &Vec<YamlNode>): Vec<YamlNode> {
    var out: Vec<YamlNode> = Vec.new()
    for i in 0..src.len {
        out.push(YamlNode {
            kind: src[i].kind, boolVal: src[i].boolVal, intVal: src[i].intVal, floatVal: src[i].floatVal,
            strIdx: src[i].strIdx, keyIdx: src[i].keyIdx, childStart: src[i].childStart, childCount: src[i].childCount,
        })
    }
    return out
}

fn cloneIdx(src: &Vec<NodeId>): Vec<NodeId> {
    var out: Vec<NodeId> = Vec.new()
    for i in 0..src.len {
        out.push(src[i])
    }
    return out
}

fn cloneStrs(src: &Vec<string>): Vec<string> {
    var out: Vec<string> = Vec.new()
    for i in 0..src.len {
        out.push(src[i].clone())
    }
    return out
}

// ── Reading a document ───────────────────────────────────────────────────────

impl Yaml {
    // Handle of the document's top-level value.
    fn root(self: &Yaml): NodeId {
        return self.root
    }

    fn valid(self: &Yaml, node: NodeId): bool {
        return node.idx >= 0 && node.idx < self.nodes.len
    }

    fn kind(self: &Yaml, node: NodeId): YamlKind {
        // The field already IS a YamlKind now — the pool stores the type directly, so the
        // old i32 → variant translation table is gone. Missing is the only value the field
        // never holds; it stands for an out-of-range handle.
        if !self.valid(node) {
            return YamlKind.Missing
        }
        return self.nodes[node.idx].kind
    }

    fn exists(self: &Yaml, node: NodeId): bool {
        return self.valid(node)
    }

    fn isNull(self: &Yaml, node: NodeId): bool {
        return self.valid(node) && self.nodes[node.idx].kind == YamlKind.Null
    }

    fn isMap(self: &Yaml, node: NodeId): bool {
        return self.valid(node) && self.nodes[node.idx].kind == YamlKind.Map
    }

    fn isSeq(self: &Yaml, node: NodeId): bool {
        return self.valid(node) && self.nodes[node.idx].kind == YamlKind.Seq
    }

    fn isScalar(self: &Yaml, node: NodeId): bool {
        return self.valid(node) && (self.nodes[node.idx].kind as i32) <= (YamlKind.Str as i32)
    }

    // Number of children: sequence entries, or map entries. 0 for scalars.
    fn len(self: &Yaml, node: NodeId): i64 {
        if !self.valid(node) {
            return 0
        }
        return self.nodes[node.idx].childCount
    }

    // i-th child of a sequence or map, or nil.
    fn at(self: &Yaml, node: NodeId, i: i64): NodeId {
        if !self.valid(node) || i < 0 || i >= self.nodes[node.idx].childCount {
            return nilNode()
        }
        return self.childIdx[self.nodes[node.idx].childStart + i]
    }

    // Key of the i-th map entry, or "".
    fn keyAt(self: &Yaml, node: NodeId, i: i64): string {
        let child = self.at(node, i)
        if isNilNode(child) {
            return ""
        }
        let k = self.nodes[child.idx].keyIdx
        if isNilStr(k) {
            return ""
        }
        return self.strs[k.idx].clone()
    }

    // Value for `key`, or nil. First match wins, so an explicit key beats one
    // spliced in by a `<<` merge.
    fn get(self: &Yaml, node: NodeId, key: string): NodeId {
        if !self.isMap(node) {
            return nilNode()
        }
        for i in 0..self.nodes[node.idx].childCount {
            let child = self.childIdx[self.nodes[node.idx].childStart + i]
            let k = self.nodes[child.idx].keyIdx
            if !isNilStr(k) && self.strs[k.idx] == key {
                return child
            }
        }
        return nilNode()
    }

    fn has(self: &Yaml, node: NodeId, key: string): bool {
        return !isNilNode(self.get(node, key))
    }

    // Dotted lookup from the root: "server.hosts.0.name". A numeric segment
    // indexes a sequence.
    fn path(self: &Yaml, p: string): NodeId {
        var node = self.root
        var seg = ""
        var i: i64 = 0
        while i <= p.len {
            if i == p.len || p[i] == '.' {
                if seg.len > 0 {
                    node = self.step(node, seg)
                    if isNilNode(node) {
                        return nilNode()
                    }
                    seg = ""
                }
            } else {
                seg.push(p[i])
            }
            i = i + 1
        }
        return node
    }

    fn step(self: &Yaml, node: NodeId, seg: &string): NodeId {
        if self.isSeq(node) {
            if let Option.Some(n) = parseInt(seg.clone()) {
                return self.at(node, n)
            }
            return nilNode()
        }
        return self.get(node, seg.clone())
    }

    // The scalar's source text, whatever its type — "" for containers.
    fn text(self: &Yaml, node: NodeId): string {
        if !self.valid(node) {
            return ""
        }
        let s = self.nodes[node.idx].strIdx
        if isNilStr(s) {
            return ""
        }
        return self.strs[s.idx].clone()
    }

    fn asStr(self: &Yaml, node: NodeId): Option<string> {
        if !self.valid(node) || self.nodes[node.idx].kind != YamlKind.Str {
            return Option.None
        }
        return Option.Some(self.text(node))
    }

    fn asInt(self: &Yaml, node: NodeId): Option<i64> {
        if !self.valid(node) || self.nodes[node.idx].kind != YamlKind.Int {
            return Option.None
        }
        return Option.Some(self.nodes[node.idx].intVal)
    }

    // Ints answer here too — a YAML `1` is a perfectly good float.
    fn asFloat(self: &Yaml, node: NodeId): Option<f64> {
        if !self.valid(node) {
            return Option.None
        }
        let k = self.nodes[node.idx].kind
        if k != YamlKind.Float && k != YamlKind.Int {
            return Option.None
        }
        return Option.Some(self.nodes[node.idx].floatVal)
    }

    fn asBool(self: &Yaml, node: NodeId): Option<bool> {
        if !self.valid(node) || self.nodes[node.idx].kind != YamlKind.Bool {
            return Option.None
        }
        return Option.Some(self.nodes[node.idx].boolVal)
    }

    fn getStr(self: &Yaml, node: NodeId, key: string): Option<string> {
        return self.asStr(self.get(node, key))
    }

    fn getInt(self: &Yaml, node: NodeId, key: string): Option<i64> {
        return self.asInt(self.get(node, key))
    }

    fn getFloat(self: &Yaml, node: NodeId, key: string): Option<f64> {
        return self.asFloat(self.get(node, key))
    }

    fn getBool(self: &Yaml, node: NodeId, key: string): Option<bool> {
        return self.asBool(self.get(node, key))
    }
}

// ── JSON output ──────────────────────────────────────────────────────────────

fn jsonEscape(out: &mut string, s: &string) {
    out.push('"')
    for c in s {
        if c == '"' || c == '\\' {
            out.push('\\')
            out.push(c)
        } else if c == '\n' {
            out.pushStr("\\n")
        } else if c == '\t' {
            out.pushStr("\\t")
        } else if c == '\r' {
            out.pushStr("\\r")
        } else if c < 32 {
            out.pushStr("\\u00")
            let hi = (c / 16) as i64
            let lo = (c % 16) as i64
            out.push(hexDigit(hi))
            out.push(hexDigit(lo))
        } else {
            out.push(c)
        }
    }
    out.push('"')
}

fn hexDigit(v: i64): u8 {
    if v < 10 {
        return ('0' as i64 + v) as u8
    }
    return ('a' as i64 + v - 10) as u8
}

// YAML floats accept spellings JSON does not: `+1.5`, `.5`, `1_0.5`, and the
// infinities. JSON has no infinity or NaN literal, so those become null.
fn jsonNumber(text: &string): string {
    if text.contains("inf") || text.contains("Inf") || text.contains("INF")
        || text.contains("nan") || text.contains("NaN") || text.contains("NAN") {
        return "null"
    }
    var s = stripUnderscores(text)
    if s.len > 0 && s[0] == '+' {
        s = s.substr(1, s.len)
    }
    if s.len > 0 && s[0] == '.' {
        var withZero = "0"
        withZero.pushStr(s)
        return withZero
    }
    if s.len > 1 && s[0] == '-' && s[1] == '.' {
        var withZero = "-0"
        withZero.pushStr(s.substr(1, s.len))
        return withZero
    }
    return s
}

fn emitJson(y: &Yaml, node: NodeId, out: &mut string) {
    let k = y.kind(node)
    match k {
        YamlKind.Missing => { out.pushStr("null") }
        YamlKind.Null => { out.pushStr("null") }
        YamlKind.Bool => { out.pushStr(if y.asBool(node) ?? false { "true" } else { "false" }) }
        YamlKind.Int => { out.pushStr($"{y.asInt(node) ?? 0}") }
        YamlKind.Float => { out.pushStr(jsonNumber(y.text(node))) }
        YamlKind.Str => { jsonEscape(out, y.text(node)) }
        YamlKind.Seq => {
            out.push('[')
            for i in 0..y.len(node) {
                if i > 0 {
                    out.push(',')
                }
                emitJson(y, y.at(node, i), out)
            }
            out.push(']')
        }
        YamlKind.Map => {
            out.push('{')
            for i in 0..y.len(node) {
                if i > 0 {
                    out.push(',')
                }
                jsonEscape(out, y.keyAt(node, i))
                out.push(':')
                emitJson(y, y.at(node, i), out)
            }
            out.push('}')
        }
    }
}

// Render a parsed document as compact JSON. Useful for diffing against another
// parser, and for handing YAML config to anything that already speaks JSON.
pub fn yamlToJson(y: &Yaml): string {
    var out = ""
    emitJson(y, y.root(), out)
    return out
}
